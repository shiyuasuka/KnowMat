# =============================================================================
# KnowMat 环境变量模板 → 复制为 `.env` 后填写真实值
# =============================================================================
#
# PP-StructureV3 表格/公式精修由代码强制开启（忽略 KNOWMAT_SKIP_PPSTRUCTURE_REFINE）。
# 化学式裁剪重 OCR 仍可用 KNOWMAT_SKIP_CHEM_REOCR 关闭以省显存。
#

# --- LLM（OpenAI 兼容 / 千帆等）---
LLM_API_KEY="your-llm-api-key-here"
LLM_BASE_URL="https://api.minimaxi.com/v1"
LLM_MODEL="MiniMax-M2.7"

# --- PaddleOCR-VL ---
PADDLEOCRVL_MODEL_DIR="models/paddleocrvl1_5"
PADDLEOCRVL_VERSION="1.5"
PADDLE_PDX_CACHE_HOME="models/paddleocrvl1_5"
# 仅排错时用 CPU；正常留空以使用 GPU（多 PDF 后若 VL 报错可显式写 gpu:0）
# KNOWMAT_OCR_DEVICE="cpu"
# 仅紧急调试：VL 不可用时允许降级到传统行 OCR（仍跑 PP-StructureV3 精修，无 VL restructure）
# KNOWMAT_ALLOW_LEGACY_PADDLEOCR="1"
# 默认跳过 VL 的 engine.close()，避免多 PDF 连续跑时下一本出现 Place(undefined:0)；需激进释放原生资源时再开
# KNOWMAT_PADDLEOCR_VL_EXPLICIT_CLOSE="1"

# --- OCR：质量优先（推荐起点，精修链条完整）---
# OCR_RENDER_DPI：300 为 README 默认，细字/公式/表格更稳；200 省显存但略损细节
OCR_RENDER_DPI="300"
# OCR_BATCH_SIZE：2 为 VL 批推理默认；8GB 若 CUDA OOM 再改为 1
OCR_BATCH_SIZE="2"
# 长 PDF 分段释放显存，不关闭精修；0=不分段（短文档可关）
# OCR_PAGES_PER_RELEASE="4"
OCR_MAX_RENDER_WORKERS="4"
OMP_NUM_THREADS="1"

# 低置信度：统计用阈值；精修后仍可疑的正文可用 tag 提醒下游（默认 none 不改行为）
OCR_LOW_CONFIDENCE_THRESHOLD="0.5"
# KNOWMAT_OCR_LOW_CONF_ACTION="none"
# KNOWMAT_OCR_LOW_CONF_ACTION="tag"

# 单次推理防挂死（秒），0=关闭；超时无法杀掉 CUDA 内核，仅避免进程无限等待
# OCR_INFER_TIMEOUT_SEC="0"

# --- 仅当显存不足且可接受效果下降时：可跳过化学式重 OCR（StructureV3 仍会运行）---
# KNOWMAT_SKIP_CHEM_REOCR="true"
# 仍 OOM 时的顺序建议：OCR_BATCH_SIZE=1 → OCR_RENDER_DPI=200 → OCR_PAGES_PER_RELEASE=4

# --- 调试 / 部分页 / 缓存 ---
# KNOWMAT_OCR_PAGES="1-10"
# KNOWMAT_OCR_SKIP_CACHED="1"
# KNOWMAT_OCR_NO_CACHE_WRITE="1"

# --- KnowMat 行为 ---
KNOWMAT2_TRIM_REFERENCES_SECTION="false"
# material-extractor alpha25 包根目录（相对项目根目录或绝对路径）。
# KNOWMAT2_ALPHA25_PACKAGE_ROOT="material-extractor-alpha25-20260804/material-extractor"
# 图表数字化：折线坐标由 PDF vector/raster 代码生成，VLM 只做分类、标签和
# 刻度标定；bar 保留离散 CSV 路由。结果注入为 '> [Figure N VLM-digitized]'。
# KNOWMAT2_CHART_DIGITIZATION_ENABLED="0"
# Raster fallback only runs when the VLM confidently classifies a crop as a
# line chart. The VLM supplies labels/tick calibration, never curve points.
# KNOWMAT2_LINE_CHART_CLASSIFICATION_MIN_CONFIDENCE="0.7"
# Cache only validated chart JSON responses. The key includes the image hash,
# endpoint, model and complete request, so reruns reuse identical calibration.
# Set 0 to disable positive caching.
# KNOWMAT2_VLM_POSITIVE_CACHE_TTL_SECONDS="604800"
# Full line-chart points are written to sidecar CSVs. These limits bound only
# the deterministic summary injected into the LLM Markdown context.
# KNOWMAT2_CHART_CONTEXT_MAX_CHARS_PER_FIGURE="2400"
# KNOWMAT2_CHART_CONTEXT_MAX_CHARS_PER_PAPER="12000"
# KNOWMAT2_CHART_CONTEXT_MAX_SERIES="12"
# Frozen alpha25 figure enrichment is chart-only by default. Set to 1 only when
# generic 200-500 word micrograph prose is intentionally needed in LLM context.
# KNOWMAT2_ALPHA25_FIGURE_PROSE_FALLBACK="0"
# 图像 prose 描述(显微图等的 '> [Figure N AI Description]',仅上下文)。默认开,设 0 关。
# KNOWMAT2_FIGURE_DESCRIPTION_ENABLED="0"
# OpenAI-compatible endpoint 能力配置，不按模型名推断。
# KNOWMAT2_LLM_API_MODE="chat_completions"  # chat_completions|responses
# KNOWMAT2_LLM_OMIT_TEMPERATURE="0"
# 抽取 LLM 单次调用超时(秒)；超时只重试相同证据，不拆分或丢弃。
# KNOWMAT2_EXTRACTION_TIMEOUT="180"
# Provider 能力按 endpoint 配置，不按模型名硬编码。低延迟抽取可显式设置
# disabled；provider 不支持时同一请求会自动降级到 provider_default。
# KNOWMAT2_EXTRACTION_THINKING="provider_default"
# 可选结构化响应能力：provider_default|json_object；provider 不支持时自动降级。
# KNOWMAT2_EXTRACTION_RESPONSE_FORMAT="provider_default"
# alpha25 默认把同一证据的四个轴合并为一次请求；每条 fact 仍按自身 axis 独立
# 做逐字 evidence gate。axis_scoped 仅用于回滚/供应商对照。
# KNOWMAT2_ALPHA25_TASK_STRATEGY="combined_axes"
# KNOWMAT2_ALPHA25_PROSE_CHARS="8000"
# 普通正文容量；稀疏/密集正文会在下面的通用事实信号阈值下自适应。
# KNOWMAT2_ALPHA25_TASK_CHARS="8000"
# KNOWMAT2_ALPHA25_INVENTORY_CHARS="8000"
# 普通宽表最多 8 个数据列；仅低于 36 个展开单元格时超过旧版 4 列，
# 高密度表自动回落到 4 列，另有 8K 字符硬上限。
# KNOWMAT2_ALPHA25_TABLE_COLUMNS="8"
# KNOWMAT2_ALPHA25_TABLE_ROWS="12"
# KNOWMAT2_ALPHA25_TABLE_CELLS="36"
# KNOWMAT2_ALPHA25_TABLE_MIN_COLUMNS="4"
# KNOWMAT2_ALPHA25_TABLE_MAX_CHARS="8000"
# 稀疏/普通正文最多 8K，仅极高密度正文预拆到 6K；只使用通用轴词和数值单位信号。
# KNOWMAT2_ALPHA25_DENSE_FACT_SIGNALS="60"
# KNOWMAT2_ALPHA25_DENSE_TASK_CHARS="6000"
# KNOWMAT2_ALPHA25_SPARSE_FACT_SIGNALS="4"
# KNOWMAT2_ALPHA25_SPARSE_TASK_CHARS="8000"
# KNOWMAT2_ALPHA25_MAX_UNITS_PER_TASK="8"
# KNOWMAT2_ALPHA25_TABLE_CONTEXT_CHARS="600"
# 五行×四指标以上的表格直接使用恢复预算；可按 provider 输出容量调整。
# KNOWMAT2_ALPHA25_DENSE_TABLE_CELL_THRESHOLD="16"
# 结构 observation 输出较长；结构指标表按每 16 个投影单元格预拆，避免 12K 截断后重跑。
# KNOWMAT2_ALPHA25_STRUCTURE_TABLE_CELLS="16"
# combined_axes 默认在同一次调用中返回材料 anchors 与四轴 facts；设为 0 可回滚到独立 inventory 调用。
# KNOWMAT2_ALPHA25_UNIFIED_INVENTORY="1"
# 以下轴级容量只在 KNOWMAT2_ALPHA25_TASK_STRATEGY=axis_scoped 时生效。
# KNOWMAT2_ALPHA25_STRUCTURE_CHARS="1600"
# KNOWMAT2_ALPHA25_PROPERTIES_CHARS="2500"
# KNOWMAT2_ALPHA25_MAX_TASKS="64"
# 短混合轴任务初始输出上限 8192；长正文/密集表格直接使用 12288，避免完整重生成。
# KNOWMAT2_ALPHA25_LONG_TASK_CHARS="4000"
# KNOWMAT2_ALPHA25_LONG_TASK_FACT_SIGNALS="18"
# KNOWMAT2_ALPHA25_LONG_TASK_OUTPUT_TOKENS="12288"
# KNOWMAT2_ALPHA25_RETRY_OUTPUT_TOKENS="12288"
# KNOWMAT2_ALPHA25_FAILURE_SPLIT_DEPTH="3"
# 单篇所有增预算重试和拆分子任务的总上限，防止异常响应再次放大调用数。
# KNOWMAT2_ALPHA25_MAX_RETRY_TASKS="32"
# Provider 返回绝对 quota reset 时间时，全局等待后重试同一任务；不拆分证据。
# KNOWMAT2_ALPHA25_QUOTA_MAX_RESETS_PER_CALL="4"
# KNOWMAT2_ALPHA25_QUOTA_MAX_WAIT_SECONDS="21600"
# KNOWMAT2_ALPHA25_QUOTA_GRACE_SECONDS="5"
# 限流/超时/服务端错误只重试同一请求，绝不拆分证据。
# KNOWMAT2_ALPHA25_TRANSIENT_RETRIES="1"
# KNOWMAT2_ALPHA25_TRANSIENT_BACKOFF_SECONDS="2"
# 同一 Python 进程内所有论文共享的 provider 并发上限。
# KNOWMAT2_ALPHA25_GLOBAL_CONCURRENCY="6"
# 默认将所有论文任务放入一个工作保持型共享池；0 可回滚到旧的单篇本地池。
# KNOWMAT2_ALPHA25_SHARED_TASK_POOL="1"
# 仅在关闭共享池时生效的单篇论文内部任务线程数。
# KNOWMAT2_ALPHA25_WORKERS="6"
# 仅允许读取匹配任务缓存；任何 miss 立即失败且绝不调用 provider。
# KNOWMAT2_ALPHA25_CACHE_ONLY="0"
# 每完成多少个 task 打印一次内部进度；0 关闭。
# KNOWMAT2_ALPHA25_PROGRESS_EVERY="4"
# Paper-level source-only precision promotion. It does not change prompts or
# final.json. Set to "0" only for a high-recall diagnostic replay; production
# should keep the default enabled.
# KNOWMAT2_ALPHA25_PROMOTION_ENABLED="1"
# v201 两个 source-only precision gate 默认开启。仅在冻结响应的同代码 A/B
# 重物化中设为 0；它们不改提示词、Schema、OCR/VLM 上下文或 final.json 格式。
# KNOWMAT2_ALPHA25_GLOBAL_TENSILE_SCOPE_V201="1"
# KNOWMAT2_ALPHA25_SAME_TABLE_PROPERTY_MERGE_V201="1"
# v203 仅在 source-coordinate/materialization 层补充拉伸协议、显式表格单元格，
# 并隔离源码可证明的属性投影错误。三个开关默认开启；全部设为 0 可回放 v202。
# KNOWMAT2_ALPHA25_TENSILE_PROTOCOL_LEDGER_V203="1"
# KNOWMAT2_ALPHA25_DENSE_TENSILE_TABLE_COMPLETION_V203="1"
# KNOWMAT2_ALPHA25_PROPERTY_COORDINATE_QUARANTINE_V203="1"
# KNOWMAT2_ALPHA25_TENSILE_ASSERTION_COORDINATES_V204="1"
# KNOWMAT2_ALPHA25_TENSILE_COORDINATE_FANOUT_GUARD_V204="1"
# KNOWMAT2_ALPHA25_TENSILE_RESULT_PROTOCOL_BINDING_V204="1"
# KNOWMAT2_ALPHA25_STRUCTURE_ASSERTION_ATOMICITY_V205="1"
# KNOWMAT2_ALPHA25_CHARACTERIZATION_EVENT_ATOMICITY_V205="1"
# KNOWMAT2_ALPHA25_PROPERTY_PROVENANCE_CONDITION_SEPARATION_V205="1"
# KNOWMAT2_ALPHA25_UNIQUE_MATERIAL_OWNER_CONVERGENCE_V205="1"

# --- LangSmith（可选）---
LANGCHAIN_API_KEY="your-langsmith-api-key"
LANGCHAIN_TRACING_V2="false"

# ──────────────────────────────────────────────────────────────────────────────
# MinerU API OCR Configuration
# Set MINERU_API_KEY to enable cloud-based OCR via MinerU Precision API v4.
# When set, local PaddleOCR inference will be skipped.
# ──────────────────────────────────────────────────────────────────────────────
MINERU_API_KEYS="your-mineru-api-key-here"
MINERU_MODEL_VERSION=vlm
MINERU_API_TIMEOUT_SEC=600
MINERU_LANGUAGE=en
# Set MINERU_USE_LIGHTWEIGHT=1 to use free Lightweight API (no key needed, 10MB/20page limit)
# MINERU_USE_LIGHTWEIGHT=0

# ──────────────────────────────────────────────────────────────────────────────
# PaddleOCR Cloud API
# Set PADDLEOCR_API_TOKEN to enable cloud-based OCR via PaddleOCR API.
# ──────────────────────────────────────────────────────────────────────────────
PADDLEOCR_API_TOKENS="your-paddleocr-api-token-here"
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_API_TIMEOUT_SEC=600
# 云端 VL 主 OCR 模型(不写死;默认 PaddleOCR-VL-1.5)。升级新版直接改这里,例如 PaddleOCR-VL-1.6:
PADDLEOCR_API_MODEL=PaddleOCR-VL-1.5
# 也可只写版本号 PADDLEOCRVL_VERSION=1.6(等价 PaddleOCR-VL-1.6);PADDLEOCR_API_MODEL 优先级更高。
# 注:PP-StructureV3 表格/公式精修是独立模型,始终启用,不受此项影响。


VLM_API_KEYS="your-vlm-api-token-here"
VLM_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
VLM_MODEL=xxxxxxx

#
# IMPORTANT: Never commit the real `.env` file or API keys to git.
#
